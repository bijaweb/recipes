DATABASE_URL=postgresql://myapp_user:password@localhost:5432/myapp
PORT=5005

# Generate your own with: openssl rand -hex 32
JWT_SECRET=REPLACE_ME_run_openssl_rand_hex_32

# Google OAuth Client ID, from https://console.cloud.google.com/apis/credentials
# This is the audience used to verify Google ID tokens sent by the frontend.
# It's the same Client ID as the frontend's VITE_GOOGLE_CLIENT_ID (not a secret).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Must exactly match the "url" this app was registered under in the
# platform app's Manage Users page (apps.url in the shared database).
# Used to check whether a signed-in Google account has been granted
# access there before letting them into this app.
PLATFORM_APP_URL=https://recipes.bijacorp.com
